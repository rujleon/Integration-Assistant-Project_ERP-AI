# --- Environnements virtuels ---
.venv/

# --- Fichiers d'environnement (clés API, mots de passe, etc.) ---
.env
api.env
*.env

# --- Cache et fichiers compilés ---
__pycache__/
*.py[cod]
*$py.class

# --- Fichiers de log ---
*.log

# --- Fichiers temporaires d’éditeur ---
*.swp
*.swo
*.bak
*~

# --- Jupyter et notebooks (si jamais utilisés) ---
.ipynb_checkpoints/

# --- Dossiers de configuration IDE ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# --- Fichiers système inutiles ---
.DS_Store
Thumbs.db

# --- Fichiers de build ou dépendances ---
*.egg-info/
dist/
build/
.eggs/
__pypackages__/

# --- Fichiers et caches Streamlit ---
.streamlit/

# --- Autres fichiers confidentiels ou temporaires ---
*.sqlite3
*.db
*.pkl
*.json
*.csv
*.zip
*.tar
*.gz

# --- Dossiers éventuels de données ---
data/
datasets/
tmp/
outputs/
checkpoints/

